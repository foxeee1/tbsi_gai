.DS_Store

# Generated machine output stays local. Research documentation and launchers
# are versioned; do not hide the asset ledger, rules, or experiment commands.
*.json
*.jsonl
*.txt
!README
!README.*
!README_*
!**/README
!**/README.*
!**/README_*

# Exact run identities and cohort definitions are research inputs.
!TBSI_gai/TBSI/experiments/manifests/*.txt
!TBSI_gai/TBSI/experiments/manifests/*.json
!TBSI_gai/TBSI/experiments/protocols/**/*.json
!TBSI_gai/TBSI/experiments/protocols/**/*.txt
!TBSI_gai/TBSI/experiments/protocols/**/*.csv

# Local output snapshots and independent upstream checkouts are preserved on
# disk, separately from the maintained project source tree.
/TBSI_gai/TBSI/experiments/snapshots/
/TBSI_gai/TBSI/experiments/external_repos/
/TBSI_original/
/TBSI_gai/TBSI/experiments/module_study/**/papers/

# Cleanup manifests are reviewable; the complete local recovery archive is
# retained on disk and referenced by its checksum.
/maintenance/cleanup_20261026/*.tar.gz
!/maintenance/cleanup_20261026/*.json
!/maintenance/cleanup_20261026/*.csv
!/maintenance/cleanup_20261026/*.txt
